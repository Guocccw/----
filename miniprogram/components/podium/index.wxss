:host { display: block; }
.podium {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-top: 24rpx;
}
.podium__col {
  width: 218rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.podium__col--first { margin: 0 12rpx; }
.podium__crown {
  position: absolute;
  top: -48rpx;
  font-size: 40rpx;
}
.podium__medal {
  margin-bottom: 4rpx;
  font-size: 32rpx;
}
.podium__name {
  margin-top: 8rpx;
  width: 200rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.podium__score {
  margin-top: 2rpx;
  font-size: 30rpx;
  font-weight: 700;
}
.podium__base {
  width: 100%;
  margin-top: 8rpx;
  border-radius: 16rpx 16rpx 0 0;
  background: linear-gradient(180deg, #FFE3D5, #FFF0E6);
}
.podium__base--first { height: 120rpx; }
.podium__base--second { height: 96rpx; }
.podium__base--third { height: 80rpx; }
