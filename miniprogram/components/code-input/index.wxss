:host { display: block; width: 100%; }
.code {
  position: relative;
  display: flex;
  justify-content: space-between;
  width: 100%;
}
.code__input {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 2;
}
.code__cell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 112rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text);
  font-variant-numeric: tabular-nums;
}
.code__cell--active {
  border-color: var(--color-primary);
  background: var(--color-surface-2);
  box-shadow: 0 0 0 4rpx var(--color-primary-soft);
}
.code__cell--filled {
  background: var(--color-surface-2);
}
.code--error .code__cell {
  border-color: var(--color-danger);
  background: #FFF7F7;
}
.code--error {
  animation: shake 200ms ease-out;
}
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  75% { transform: translateX(8rpx); }
}
