.rank {
  padding-top: 24rpx;
}
.rank__tabs {
  display: flex;
  height: 72rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #F6ECE3;
}
.rank__tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-2);
}
.rank__tab--active {
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: 0 4rpx 12rpx rgba(122, 63, 32, 0.08);
}
.rank__tab--disabled {
  color: var(--color-text-3);
}
.rank__soon {
  margin-left: 6rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #F6ECE3;
  font-size: 18rpx;
}
.rank__period {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-2);
}
.rank__me {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}
.rank__me--has {
  background: linear-gradient(135deg, #FFF0E6, #FFF8F0);
}
.rank__me-left {
  display: flex;
  flex-direction: column;
}
.rank__me-label {
  font-size: 24rpx;
  color: var(--color-text-2);
}
.rank__me-rank {
  margin-top: 4rpx;
  font-size: 44rpx;
  line-height: 1.1;
  font-weight: 700;
}
.rank__me-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.rank__me-score {
  font-size: 30rpx;
  font-weight: 700;
}
.rank__me-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-2);
}
.rank__me-cta {
  margin-top: 4rpx;
  font-size: 24rpx;
}
.rank__list {
  margin-top: 16rpx;
  padding: 8rpx 0;
  border-radius: 32rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}
.rank__rules {
  margin-top: 24rpx;
  padding: 24rpx 0 48rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-primary-ink);
}
.rank__error {
  margin-top: 48rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--color-warning-soft);
  color: var(--color-warning-ink);
  font-size: 26rpx;
  text-align: center;
}
.rank__error .link {
  margin-left: 12rpx;
}
.rank__empty-btn {
  width: 360rpx;
  margin-top: 24rpx;
}
