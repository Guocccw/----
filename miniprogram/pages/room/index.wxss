.room {
  padding-top: 24rpx;
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}
.room__loading {
  padding-top: 24rpx;
}
.room__head {
  padding: 28rpx 32rpx;
}
.room__label {
  font-size: 24rpx;
  color: var(--color-text-2);
}
.room__code {
  margin-top: 4rpx;
  font-size: 64rpx;
  line-height: 72rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}
.room__chips {
  display: flex;
  margin-top: 20rpx;
}
.room__chips .chip {
  margin-right: 12rpx;
}
.mini-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 64rpx;
  padding: 0 24rpx;
  margin-left: 12rpx;
  border: 2rpx solid var(--color-primary-border);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-primary-ink);
  font-size: 24rpx;
  line-height: 60rpx;
}
.mini-btn::after { border: 0; }
.mini-btn--share {
  background: var(--color-primary-soft);
}
.seats {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 24rpx;
}
.seat-empty {
  margin-bottom: 20rpx;
}
.seat-empty {
  width: 333rpx;
  height: 176rpx;
  border: 2rpx dashed #E6D5C7;
  border-radius: 28rpx;
  background: var(--color-surface-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-text-2);
  font-size: 24rpx;
  line-height: 1.4;
}
.seat-empty::after { border: 0; }
.seat-empty__plus {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}
.seat-empty__text {
  font-size: 24rpx;
}
.room__hint {
  margin-top: 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-2);
}
.room__count {
  margin-top: 4rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-2);
}
.room__leave {
  display: flex;
  justify-content: center;
  width: 100%;
  margin-top: 4rpx;
}
