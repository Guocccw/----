.result {
  min-height: 100vh;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}
.result__nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  box-sizing: content-box;
}
.result__close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--color-text);
}
.result__nav-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}
.result__nav-space {
  width: 150rpx;
}
.result__body {
  padding: 8rpx 32rpx 0;
}
.result__stats {
  display: flex;
  margin-top: 24rpx;
  padding: 24rpx 8rpx;
}
.result__stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.result__stat + .result__stat {
  border-left: 2rpx solid var(--color-divider);
}
.result__stat-num {
  font-size: 40rpx;
  line-height: 1.1;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.result__stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-2);
}
.result__list {
  margin-top: 24rpx;
  padding: 8rpx 16rpx;
}
.result__row {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
}
.result__row--head {
  height: 44rpx;
  font-size: 22rpx;
  color: var(--color-text-2);
}
.result__row--me {
  background: var(--color-primary-soft);
  box-shadow: inset 4rpx 0 0 var(--color-primary);
}
.result__no {
  width: 64rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}
.result__row--head .result__no,
.result__row--head .result__score,
.result__row--head .result__correct {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-text-2);
}
.result__player {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
.result__name {
  margin-left: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.result__left {
  margin-left: 8rpx;
  height: 32rpx;
  font-size: 18rpx;
  padding: 0 10rpx;
}
.result__score {
  width: 100rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 700;
}
.result__correct {
  width: 84rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--color-text-2);
}
.result__bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255,248,240,0), #FFF8F0 20rpx);
}
.result__hint {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-2);
}
.result__actions {
  display: flex;
  justify-content: center;
  margin-top: 4rpx;
}
.result__actions .btn {
  margin: 0 12rpx;
}
.result__home-btn {
  margin-top: 40rpx;
  width: 400rpx;
}
