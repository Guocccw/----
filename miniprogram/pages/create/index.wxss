.create {
  padding-top: 40rpx;
}
.create__title {
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 600;
}
.create__sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-2);
}
.segmented {
  display: flex;
  justify-content: space-between;
}
.segmented__item {
  position: relative;
  width: 218rpx;
  height: 104rpx;
  padding: 14rpx 12rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.segmented__item--active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}
.segmented__value {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.1;
}
.segmented__desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-2);
}
.segmented__check {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  font-size: 22rpx;
  color: var(--color-primary-ink);
  font-weight: 700;
}
.summary {
  margin-top: 40rpx;
  padding: 28rpx 24rpx;
  font-size: 26rpx;
  color: var(--color-text-2);
}
.create__error {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--color-danger-ink);
  text-align: center;
}
